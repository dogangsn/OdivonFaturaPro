    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-server": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@angular/ssr": "^20.0.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "chart.js": "^4.5.1",
    "express": "^5.1.0",
    "firebase": "^10.0.0",
    "firebaseui": "^6.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
